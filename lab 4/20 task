<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Мини-мастер регистрации</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            padding: 30px;
        }

        .container {
            width: 450px;
            margin: auto;
        }

        .block {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 10px;
            box-shadow: 0 0 8px #ccc;
        }

        h2 {
            margin-top: 0;
            color: #333;
        }

        label {
            display: block;
            margin-top: 10px;
        }

        input, select, button {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            box-sizing: border-box;
        }

        button {
            margin-top: 15px;
            background: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background: #45a049;
        }

        .error {
            color: red;
            font-weight: bold;
        }

        .success {
            color: green;
            font-weight: bold;
        }

        #summary {
            display: none;
            background: #e8f5e9;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #4CAF50;
        }
    </style>
</head>

<body>

<div class="container">

    <!-- Блок 1: Личные данные -->
    <div class="block">
        <h2>1. Личные данные</h2>

        <label for="fullname">ФИО:</label>
        <input type="text" id="fullname" placeholder="Введите ФИО">

        <label for="birthdate">Дата рождения:</label>
        <input type="date" id="birthdate">

        <button type="button" onclick="checkPersonalData()">
            Проверить личные данные
        </button>

        <p id="personalMessage"></p>
    </div>


    <!-- Блок 2: Параметры аккаунта -->
    <div class="block">
        <h2>2. Параметры аккаунта</h2>

        <label for="login">Логин:</label>
        <input type="text" id="login" placeholder="Введите логин">

        <label for="email">E-mail:</label>
        <input type="email" id="email" placeholder="Введите e-mail">

        <label for="password">Пароль:</label>
        <input type="password" id="password" placeholder="Введите пароль">

        <button type="button" onclick="checkAccountData()">
            Проверить аккаунт
        </button>

        <p id="accountMessage"></p>
    </div>


    <!-- Итоговое резюме -->
    <div id="summary">
        <h2>Итоговое резюме</h2>

        <p><strong>ФИО:</strong> <span id="summaryName"></span></p>
        <p><strong>Дата рождения:</strong> <span id="summaryBirthdate"></span></p>
        <p><strong>Логин:</strong> <span id="summaryLogin"></span></p>
        <p><strong>E-mail:</strong> <span id="summaryEmail"></span></p>

        <p class="success">
            Регистрация заполнена корректно!
        </p>
    </div>

</div>


<script>
    let personalDataValid = false;
    let accountDataValid = false;


    // Проверка блока личных данных
    function checkPersonalData() {

        const fullname = document.getElementById('fullname').value.trim();
        const birthdate = document.getElementById('birthdate').value;
        const message = document.getElementById('personalMessage');

        if (fullname === '') {
            message.textContent = 'Введите ФИО';
            message.className = 'error';
            personalDataValid = false;
            return;
        }

        if (birthdate === '') {
            message.textContent = 'Укажите дату рождения';
            message.className = 'error';
            personalDataValid = false;
            return;
        }

        message.textContent = 'Личные данные заполнены корректно';
        message.className = 'success';

        personalDataValid = true;

        showSummary();
    }


    // Проверка блока аккаунта
    function checkAccountData() {

        const login = document.getElementById('login').value.trim();
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        const message = document.getElementById('accountMessage');

        if (login === '') {
            message.textContent = 'Введите логин';
            message.className = 'error';
            accountDataValid = false;
            return;
        }

        if (email === '') {
            message.textContent = 'Введите e-mail';
            message.className = 'error';
            accountDataValid = false;
            return;
        }

        if (password === '') {
            message.textContent = 'Введите пароль';
            message.className = 'error';
            accountDataValid = false;
            return;
        }

        if (password.length < 8) {
            message.textContent =
                'Пароль должен содержать не менее 8 символов';
            message.className = 'error';
            accountDataValid = false;
            return;
        }

        message.textContent = 'Параметры аккаунта заполнены корректно';
        message.className = 'success';

        accountDataValid = true;

        showSummary();
    }


    // Вывод итогового резюме
    function showSummary() {

        if (personalDataValid && accountDataValid) {

            document.getElementById('summaryName').textContent =
                document.getElementById('fullname').value;

            document.getElementById('summaryBirthdate').textContent =
                document.getElementById('birthdate').value;

            document.getElementById('summaryLogin').textContent =
                document.getElementById('login').value;

            document.getElementById('summaryEmail').textContent =
                document.getElementById('email').value;

            document.getElementById('summary').style.display = 'block';
        }
    }
</script>

</body>
</html>
