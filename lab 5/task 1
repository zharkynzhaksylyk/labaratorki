function calculate() {
    const number1 = Number(document.getElementById("number1").value);
    const number2 = Number(document.getElementById("number2").value);

    let results = [];

    results.push("Сложение: " + (number1 + number2));
    results.push("Вычитание: " + (number1 - number2));
    results.push("Умножение: " + (number1 * number2));

    if (number2 !== 0) {
        results.push("Деление: " + (number1 / number2));
    } else {
        results.push("Деление: на ноль невозможно");
    }

    let output = "";

    for (let i = 0; i < results.length; i++) {
        output += results[i] + "<br>";
    }

    document.getElementById("result").innerHTML = output;
}
