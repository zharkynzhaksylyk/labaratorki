```javascript
function createCard() {
    const name = document.getElementById("name").value;
    const group = document.getElementById("group").value;
    const course = document.getElementById("course").value;

    const card = document.createElement("div");

    if (name === "" || group === "" || course === "") {
        card.textContent = "Пожалуйста, заполните все поля.";
    } else {
        card.innerHTML = `
            <h2>Карточка студента</h2>
            <p><strong>Имя:</strong> ${name}</p>
            <p><strong>Группа:</strong> ${group}</p>
            <p><strong>Курс:</strong> ${course}</p>
        `;
    }

    document.getElementById("studentCard").appendChild(card);
}
```
