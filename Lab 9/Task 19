 <h1>Поиск публикаций</h1>
 <p class="hint">Вариант 19: debounce + AbortController (JSONPlaceholder /posts)</p>
 
 <input id="search" type="search" placeholder="Введите слово, например: qui" autocomplete="off">
 
 <p id="status" role="status"></p>
 <button id="retry" hidden>Повторить</button>
 <p id="time"></p>
 
 <ul id="results"></ul>
