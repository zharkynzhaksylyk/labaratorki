app.js
const API = 'https://jsonplaceholder.typicode.com/posts';
const DELAY = 500; // задержка debounce, мс
 
const input = document.querySelector('#search');
const statusEl = document.querySelector('#status');
const retryBtn = document.querySelector('#retry');
const timeEl = document.querySelector('#time');
const results = document.querySelector('#results');
 
let controller = null; // для отмены предыдущего запроса
let timerId = null;    // таймер debounce
let lastQuery = '';
 
function setStatus(type, text) {
 statusEl.className = type;
 statusEl.textContent = text;
}
 
function render(posts) {
 results.replaceChildren();
 for (const post of posts) {
   const li = document.createElement('li');
   const title = document.createElement('h3');
   const body = document.createElement('p');
   title.textContent = `${post.id}. ${post.title}`; // безопасно: textContent
   body.textContent = post.body;
   li.append(title, body);
   results.append(li);
 }
}
 
async function search(query) {
 lastQuery = query;
 if (controller) controller.abort(); // отмена предыдущего запроса
 controller = new AbortController();
 
 setStatus('loading', 'Загрузка...');
 retryBtn.hidden = true;
 timeEl.textContent = '';
 results.replaceChildren();
 
 const url = `${API}?_limit=10` + (query ? `&q=${encodeURIComponent(query)}` : '');
 const start = performance.now();
 
 try {
   const response = await fetch(url, { signal: controller.signal });
   if (!response.ok) throw new Error(`HTTP ${response.status}`);
   const posts = await response.json();
 
   timeEl.textContent = `Время ответа: ${Math.round(performance.now() - start)} мс`;
   if (posts.length === 0) {
     setStatus('success', 'Ничего не найдено');
     return;
   }
   render(posts);
   setStatus('success', `Найдено: ${posts.length}`);
 } catch (error) {
   if (error.name === 'AbortError') return; // отмена — не ошибка
   setStatus('error', `Ошибка загрузки: ${error.message}`);
   retryBtn.hidden = false;
 }
}
 
input.addEventListener('input', () => {
 clearTimeout(timerId);
 timerId = setTimeout(() => search(input.value.trim()), DELAY);
});
 
retryBtn.addEventListener('click', () => search(lastQuery));
 
search(''); // первая загрузка
