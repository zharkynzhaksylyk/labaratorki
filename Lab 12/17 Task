// Access Token хранится исключительно в замыкании/переменной памяти (не в localStorage)
let accessToken = null;

const loginView = document.getElementById('loginView');
const appView = document.getElementById('appView');
const errorMsg = document.getElementById('errorMsg');
const logOutput = document.getElementById('logOutput');
const tokenPreview = document.getElementById('tokenPreview');

function log(msg) {
  logOutput.textContent = `[${new Date().toLocaleTimeString()}] ${msg}\n` + logOutput.textContent;
}

function updateTokenDisplay() {
  tokenPreview.textContent = accessToken
    ? `${accessToken.slice(0, 35)}...${accessToken.slice(-20)}`
    : 'null';
}

// Обновление пары токенов через HttpOnly Refresh Cookie
async function refreshAccessToken() {
  const res = await fetch('/api/auth/refresh', { method: 'POST' });
  if (!res.ok) {
    accessToken = null;
    updateTokenDisplay();
    return false;
  }
  const data = await res.json();
  accessToken = data.accessToken;
  updateTokenDisplay();
  log('Выполнена ротация Refresh Token и получен новый Access Token.');
  return true;
}

// Обертка над fetch с автоматическим перехватом 401 и обновлением токена
async function authFetch(url, options = {}) {
  const makeRequest = () => fetch(url, {
    ...options,
    headers: {
      ...(options.headers || {}),
      ...(accessToken ? { Authorization: `Bearer ${accessToken}` } : {})
    }
  });

  let res = await makeRequest();
  if (res.status === 401) {
    log('Access Token истек или отсутствует (401). Попытка обновления...');
    const refreshed = await refreshAccessToken();
    if (refreshed) {
      res = await makeRequest(); // Повторяем исходный запрос с новым токеном
    }
  }
  return res;
}

async function loadSecureData() {
  const res = await authFetch('/api/secure-data');
  if (!res.ok) {
    appView.classList.add('hidden');
    loginView.classList.remove('hidden');
    return;
  }
  const data = await res.json();
  loginView.classList.add('hidden');
  appView.classList.remove('hidden');
  log(`Данные получены: ${data.user.name} (${data.user.role})`);
}

document.getElementById('loginForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  errorMsg.textContent = '';
  const login = document.getElementById('login').value;
  const password = document.getElementById('password').value;

  const res = await fetch('/api/auth/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ login, password })
  });

  const data = await res.json();
  if (!res.ok) {
    errorMsg.textContent = data.error;
    return;
  }

  accessToken = data.accessToken;
  updateTokenDisplay();
  logOutput.textContent = '';
  log('Успешный вход. Выдана первичная пара токенов.');
  await loadSecureData();
});

document.getElementById('fetchDataBtn').addEventListener('click', loadSecureData);

document.getElementById('logoutBtn').addEventListener('click', async () => {
  await fetch('/api/auth/logout', { method: 'POST' });
  accessToken = null;
  updateTokenDisplay();
  appView.classList.add('hidden');
  loginView.classList.remove('hidden');
});

// При обновлении страницы accessToken в RAM сбрасывается, но восстанавливается через HttpOnly cookie
(async () => {
  const ok = await refreshAccessToken();
  if (ok) await loadSecureData();
})();
