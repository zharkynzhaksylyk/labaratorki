const express = require('express');
const cookieParser = require('cookie-parser');
const bcrypt = require('bcryptjs');
const crypto = require('crypto');
const path = require('path');

const app = express();
app.use(express.json());
app.use(cookieParser());
app.use(express.static(path.join(__dirname, 'public')));

// Тестовая база пользователей (пароль: "student123")
const users = [
  {
    id: 1,
    login: 'student01',
    passwordHash: bcrypt.hashSync('student123', 10),
    fullName: 'Иванов Алексей',
    group: 'ИС-21',
    gpa: 3.85
  }
];

// Хранилище активных сессий
const sessions = new Map();

// Middleware проверки авторизации
function requireAuth(req, res, next) {
  const sid = req.cookies.sid;
  if (!sid || !sessions.has(sid)) {
    return res.status(401).json({ error: 'Требуется вход в систему' });
  }
  req.user = sessions.get(sid);
  next();
}

// Вход
app.post('/api/login', (req, res) => {
  const { login, password } = req.body;

  if (!login || !password || !login.trim() || !password.trim()) {
    return res.status(400).json({ error: 'Заполните логин и пароль' });
  }

  const user = users.find(u => u.login === login.trim());
  if (!user || !bcrypt.compareSync(password, user.passwordHash)) {
    return res.status(401).json({ error: 'Неверный логин или пароль' });
  }

  const sid = crypto.randomUUID();
  sessions.set(sid, { id: user.id, fullName: user.fullName, group: user.group, gpa: user.gpa });

  res.cookie('sid', sid, {
    httpOnly: true,
    sameSite: 'lax'
    // secure: true // включить при использовании HTTPS
  });

  res.json({ message: 'Вход выполнен успешно' });
});

// Защищенный ресурс: данные личного кабинета студента
app.get('/api/cabinet', requireAuth, (req, res) => {
  res.json({
    fullName: req.user.fullName,
    group: req.user.group,
    gpa: req.user.gpa
  });
});

// Выход
app.post('/api/logout', (req, res) => {
  const sid = req.cookies.sid;
  if (sid) sessions.delete(sid);
  res.clearCookie('sid');
  res.json({ message: 'Вы вышли из системы' });
});

app.listen(3000, () => console.log('Вариант 1 запущен: http://localhost:3000'));




