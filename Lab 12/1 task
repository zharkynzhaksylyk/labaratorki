    <h2>Вход для студента</h2>
    <form id="loginForm" novalidate>
      <input id="login" placeholder="Логин (student01)" required>
      <input id="password" type="password" placeholder="Пароль (student123)" required>
      <button type="submit">Войти</button>
    </form>
